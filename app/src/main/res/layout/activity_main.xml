<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STUDENT PLANNER"
            android:textColor="#6558D3"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Hello 👋"
            android:textColor="#202344"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Your day starts here."
            android:textColor="#777991"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#6558D3"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR DAILY GOALS"
                android:textColor="#E5E1FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Plan your day,\nachieve your goals."
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="One task at a time. Keep going!"
                android:textColor="#E5E1FF"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Your workspace"
            android:textColor="#202344"
            android:textSize="21sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClasses"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#E4E7FF"
            android:text="📚   Class Schedule"
            android:textAllCaps="false"
            android:textColor="#38358D"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnRoutine"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#DDF5E9"
            android:text="✓   Daily Routine"
            android:textAllCaps="false"
            android:textColor="#216847"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnActivities"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FBE9D8"
            android:text="📅   Academic Activities"
            android:textAllCaps="false"
            android:textColor="#895323"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:padding="12dp"
            android:text="Stay organized • Stay focused • Succeed"
            android:textColor="#777991"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
